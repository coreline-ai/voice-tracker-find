# thinktank 환경변수 예시
# 사용법: 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 git 에서 제외됨)

# --- 필수 ---
# AI 백엔드: "api"(Claude API 키 사용) 또는 "claude_cli"(로컬 claude 로그인 사용, 키 불필요)
AI_PROVIDER=claude_cli

# AI_PROVIDER=api 일 때만 필수
CLAUDE_API_KEY=

# --- 선택 (미설정 시 아래 기본값 사용) ---

# 수집 경로: Syncthing 폴더 (녹음 파일 유입 위치)
INGEST_DIR=~/.thinktank/inbox

# 볼트 경로: Obsidian 볼트 루트
OBSIDIAN_VAULT=~/thinktank-vault

# DB 경로: SQLite 파이프라인 상태 DB
DB_PATH=~/.thinktank/db/pipeline.db

# Temp 경로: 전사 임시 파일
TEMP_DIR=~/.thinktank/temp

# Whisper 모델 크기
WHISPER_MODEL=large-v3

# 받아쓰기 장치: 미설정=자동감지(torch), "cuda"=GPU 강제, "cpu"=CPU 강제
# GPU 사용 시 nvidia-cudnn-cu12 / nvidia-cublas-cu12 설치 필요
# WHISPER_DEVICE=cuda

# VAD 파라미터
VAD_SAMPLE_RATE=16000
VAD_THRESHOLD=0.5

# 보관 기간 (일). 이 기간 경과 후 처리 완료 녹음 폐기 대상
RETENTION_DAYS=7

# --- LAN 수신기 (모드1: 같은 WiFi 에서 폰 -> PC 직접 전송) ---
# 앱과 나눠 갖는 인증 토큰. 비어 있으면 수신기가 뜨지 않는다(파이프라인은 무관).
# 생성 예: python -c "import secrets; print(secrets.token_urlsafe(32))"
RECEIVER_TOKEN=

# 수신기 포트 (앱 설정의 서버 주소에 동일하게 입력: http://<PC IP>:8765)
RECEIVER_PORT=8765

# TLS: 인증서+개인키 PEM 경로. 비우면 평문 HTTP.
# 앱이 공개키 피닝을 지원한 뒤에 켤 것 — 먼저 켜면 앱이 못 붙는다.
#   생성: python -m thinktank.receiver --make-cert ~/.thinktank/receiver-cert.pem --host <PC IP>
#   출력된 sha256/... 핀을 앱 설정에 입력한다. 설치할 인증서는 없다.
# RECEIVER_CERT=~/.thinktank/receiver-cert.pem

# 폰이 내려받을 APK 경로. 비우면 /apk 가 404.
# 런처(run_receiver.ps1)가 ~/.thinktank/thinktank-recorder.apk 를 자동으로 잡으므로,
# 그 경로에 APK 를 복사해 두면 보통 이 값을 설정할 필요 없다.
# RECEIVER_APK=~/.thinktank/thinktank-recorder.apk

# 업로드가 끝나면 파이프라인(STT→노트)을 자동 실행할지. 기본 켜짐(1).
# 0/false 로 끄면 예전처럼 야간 작업·수동 실행만 처리한다.
# RECEIVER_AUTO_PROCESS=1
