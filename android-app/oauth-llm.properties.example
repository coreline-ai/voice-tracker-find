# Optional OAuth LLM public-client override template.
# Source-controlled compatibility defaults live in oauth-llm.defaults.properties.
# Append only overrides you need to the ignored android-app/local.properties file.
# Never add a client secret, token, authorization code, PKCE value, cookie, or account credential.

AIRVOICE_ANTHROPIC_CLIENT_ID=
AIRVOICE_ANTHROPIC_MODEL=
AIRVOICE_CODEX_CLIENT_ID=
AIRVOICE_CODEX_MODEL=
AIRVOICE_XAI_CLIENT_ID=
AIRVOICE_XAI_MODEL=
