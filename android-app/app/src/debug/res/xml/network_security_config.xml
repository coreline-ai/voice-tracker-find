<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Debug-only LAN smoke tests use the Mac mini's DHCP address. Release
        keeps cleartext disabled in the main manifest; this broad allowance is
        intentionally limited to the non-release debug variant.
    -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
